{
  "manifest_version": 3,
  "name": "Foothold",
  "version": "1.0.0",
  "description": "Find LinkedIn hiring posts, draft Gmail replies with OpenAI, download a CSV report.",
  "key": "",
  "action": {
    "default_title": "Foothold"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "identity",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.openai.com/*",
    "https://gmail.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
